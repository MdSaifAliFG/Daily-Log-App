{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"if (!process.env.npm_config_user_agent?.startsWith('pnpm')) { console.error('Use pnpm instead'); process.exit(1); }\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "check": "pnpm run typecheck",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:app": "pnpm --filter @workspace/daily-log run dev",
    "dev:app:tunnel": "pnpm --filter @workspace/daily-log run dev:tunnel",
    "dev:app:web": "pnpm --filter @workspace/daily-log run dev:web",
    "preview:app": "pnpm --filter @workspace/daily-log run preview",
    "preview:api": "pnpm --filter @workspace/api-server run start",
    "build:apk": "pnpm --filter @workspace/daily-log run build:apk",
    "dev:mockup": "pnpm --filter @workspace/mockup-sandbox run dev",
    "db:push": "pnpm --filter @workspace/db run push"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
